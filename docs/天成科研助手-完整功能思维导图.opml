      <outline text="16. 天成科研助手 Fork 特有">
        <outline text="品牌名：天成科研助手"/>
        <outline text="bundle id：science.superscience"/>
        <outline text="能力发现首页（Capabilities tiles）"/>
        <outline text="独立反馈弹窗（微信群 + 邮件客服）"/>
